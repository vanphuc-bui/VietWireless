---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SamplingAliasExplorer from '../../components/SamplingAliasExplorer.jsx';
import MathExpr from '../../components/Math.astro';

const aliasPlot = {
  width: 820,
  height: 260,
  left: 40,
  right: 28,
  mid: 130,
  amplitude: 68,
  duration: 1,
};

function cosinePolyline(frequency, points = 640) {
  return Array.from({ length: points + 1 }, (_, i) => {
    const t = (i / points) * aliasPlot.duration;
    const x = aliasPlot.left + (t / aliasPlot.duration) * (aliasPlot.width - aliasPlot.left - aliasPlot.right);
    const y = aliasPlot.mid - aliasPlot.amplitude * Math.cos(2 * Math.PI * frequency * t);
    return `${x.toFixed(2)},${y.toFixed(2)}`;
  }).join(' ');
}

const aliasFastPoints = cosinePolyline(7);
const aliasSlowPoints = cosinePolyline(3);
const aliasSamples = Array.from({ length: 11 }, (_, n) => {
  const t = n / 10;
  return {
    x: aliasPlot.left + t * (aliasPlot.width - aliasPlot.left - aliasPlot.right),
    y: aliasPlot.mid - aliasPlot.amplitude * Math.cos(2 * Math.PI * 7 * t),
  };
});
---

<BaseLayout
  title="Sampling, aliasing và Nyquist trực quan | VietWireless"
  description="Hiểu sampling rate, Nyquist frequency, aliasing và anti-alias filter bằng waveform, spectrum và interactive lab trực quan."
>
  <article class="lesson shell">
    <header class="lesson-hero">
      <a class="back-link" data-lesson-nav="map" href="/hoc/">← Về lộ trình học</a>
      <p class="eyebrow">GHI CHÉP 02 · SIGNAL FOUNDATIONS</p>
      <h1>Sampling, aliasing và Nyquist</h1>
      <p class="lesson-deck">
        ADC chỉ nhìn waveform tại một số thời điểm rời rạc. Câu hỏi là: <strong>cần nhìn nhanh tới mức nào để những sample đó vẫn giữ đủ thông tin về signal ban đầu?</strong>
      </p>
    </header>

    <section class="concept-block lesson-map-block">
      <p class="concept-kicker">BÀI NÀY NỐI TỪ ĐÂU?</p>
      <p class="map-intro">
        Ở Bài 01, waveform liên tục đã được biến thành dãy <MathExpr tex="x[n]" />. Bài này chỉ zoom vào đúng bước đó.
      </p>
      <div class="system-position">
        <span>ANALOG → DIGITAL</span>
        <div class="system-position-flow" aria-label="Waveform liên tục qua ADC thành samples">
          <span>Waveform <MathExpr tex="x(t)" /></span><b>→</b>
          <strong>Sampling</strong><b>→</b>
          <span><MathExpr tex="x[n]" /></span><b>→</b>
          <span>DSP</span>
        </div>
        <p>
          Nếu sampling đủ nhanh, dãy <MathExpr tex="x[n]" /> vẫn có thể đại diện cho waveform ban đầu trong những điều kiện nhất định.
          Nếu sampling quá chậm, nhiều waveform khác nhau có thể tạo ra cùng một dãy sample.
        </p>
      </div>
    </section>

    <section class="concept-block" id="sampling-la-gi">
      <p class="concept-kicker">01 · LẤY MẪU THEO THỜI GIAN</p>
      <h2>Sampling không biến amplitude thành các mức rời rạc. Nó chọn những thời điểm để đo waveform.</h2>
      <p>
        Giả sử một điện áp analog <MathExpr tex="x(t)" /> tồn tại liên tục theo thời gian. ADC đo giá trị của nó tại các thời điểm
        <MathExpr tex={String.raw`0,\,T_s,\,2T_s,\,3T_s,\ldots`} /> Khi đó:
      </p>

      <MathExpr tex="x[n] = x(nT_s)" display />
      <p class="math-caption"><MathExpr tex={String.raw`n = 0,1,2,\ldots`} /> và <MathExpr tex="T_s" /> là khoảng thời gian giữa hai lần lấy mẫu.</p>

      <div class="sampling-visual sampling-process-visual" aria-label="Waveform liên tục được lấy mẫu rồi lượng tử hóa">
        <article class="sampling-stage">
          <span class="sampling-stage-label">1 · WAVEFORM</span>
          <svg viewBox="0 0 320 150" role="img" aria-label="Waveform liên tục">
            <line class="sample-axis" x1="18" y1="75" x2="304" y2="75" />
            <path class="analog-wave" d="M20 82 C44 22 69 24 92 78 S138 126 163 65 S210 18 232 79 S275 125 302 56" />
            <text class="sample-svg-label" x="278" y="68">thời gian</text>
          </svg>
          <strong><MathExpr tex="x(t)" /></strong>
          <p>Giá trị tồn tại ở mọi thời điểm.</p>
        </article>

        <div class="sampling-arrow" aria-hidden="true">→</div>

        <article class="sampling-stage sampling-stage-center">
          <span class="sampling-stage-label">2 · SAMPLING</span>
          <svg viewBox="0 0 320 150" role="img" aria-label="Đo waveform tại các thời điểm cách đều">
            <line class="sample-axis" x1="18" y1="75" x2="304" y2="75" />
            <path class="analog-wave muted-wave" d="M20 82 C44 22 69 24 92 78 S138 126 163 65 S210 18 232 79 S275 125 302 56" />
            <g class="sample-stems">
              <line x1="28" y1="75" x2="28" y2="64" /><circle cx="28" cy="64" r="4" />
              <line x1="68" y1="75" x2="68" y2="38" /><circle cx="68" cy="38" r="4" />
              <line x1="108" y1="75" x2="108" y2="102" /><circle cx="108" cy="102" r="4" />
              <line x1="148" y1="75" x2="148" y2="95" /><circle cx="148" cy="95" r="4" />
              <line x1="188" y1="75" x2="188" y2="38" /><circle cx="188" cy="38" r="4" />
              <line x1="228" y1="75" x2="228" y2="72" /><circle cx="228" cy="72" r="4" />
              <line x1="268" y1="75" x2="268" y2="104" /><circle cx="268" cy="104" r="4" />
            </g>
          </svg>
          <strong><MathExpr tex="x[n]" /></strong>
          <p>Thời gian đã trở thành các sample index <MathExpr tex="n" />.</p>
        </article>

        <div class="sampling-arrow" aria-hidden="true">→</div>

        <article class="sampling-stage">
          <span class="sampling-stage-label">3 · QUANTIZATION</span>
          <svg viewBox="0 0 320 150" role="img" aria-label="Các sample được lượng tử hóa thành các mức amplitude rời rạc">
            <g class="quant-grid">
              <line x1="18" y1="30" x2="304" y2="30" />
              <line x1="18" y1="52" x2="304" y2="52" />
              <line x1="18" y1="74" x2="304" y2="74" />
              <line x1="18" y1="96" x2="304" y2="96" />
              <line x1="18" y1="118" x2="304" y2="118" />
            </g>
            <g class="quant-dots">
              <circle cx="28" cy="74" r="4" /><circle cx="68" cy="30" r="4" />
              <circle cx="108" cy="96" r="4" /><circle cx="148" cy="96" r="4" />
              <circle cx="188" cy="30" r="4" /><circle cx="228" cy="74" r="4" />
              <circle cx="268" cy="118" r="4" />
            </g>
          </svg>
          <strong><MathExpr tex={String.raw`x_q[n]`} /></strong>
          <p>Quantization thay mỗi sample amplitude bằng một giá trị/code thuộc tập mức hữu hạn.</p>
        </article>
      </div>

      <aside class="precision-note">
        <strong>Sampling và quantization là hai việc khác nhau</strong>
        <p>
          Sampling làm rời rạc trục thời gian và tạo sequence <MathExpr tex="x[n]" />.
          Quantization ánh xạ amplitude sang các mức hữu hạn, ta có thể ký hiệu đầu ra là <MathExpr tex={String.raw`x_q[n]`} />.
          Aliasing mà bài này nói tới xuất phát từ sampling theo thời gian, không phải từ số bit của ADC.
        </p>
      </aside>

      <p>
        Sampling rate là số lần đo trong một giây: <MathExpr tex="f_s = 1/T_s" />.
        Nếu <MathExpr tex={String.raw`f_s=48\,\mathrm{kHz}`} />, khoảng cách giữa hai sample là khoảng <MathExpr tex={String.raw`20.83\,\mu\mathrm{s}`} />.
      </p>
    </section>

    <section class="concept-block" id="qua-cham">
      <p class="concept-kicker">02 · KHI LẤY MẪU QUÁ CHẬM</p>
      <h2>Một dãy sample không tự nói cho ta biết waveform đã chạy qua giữa các sample như thế nào.</h2>
      <p>
        Nếu các sample nằm đủ gần nhau so với tốc độ biến thiên của signal, ta còn có cơ hội dựng lại waveform.
        Nhưng khi khoảng cách giữa các sample quá lớn, một waveform nhanh có thể đi qua đúng những điểm mà một waveform chậm hơn cũng đi qua.
      </p>

      <div class="alias-story" aria-label="Hai waveform khác tần số đi qua cùng các sample">
        <div class="visual-caption">
          <span>CÙNG SAMPLE, HAI CÁCH DIỄN GIẢI</span>
          <strong><MathExpr tex={String.raw`7\,\mathrm{Hz}`} /> và <MathExpr tex={String.raw`3\,\mathrm{Hz}`} /> khi <MathExpr tex={String.raw`f_s=10\,\mathrm{Hz}`} /></strong>
        </div>
        <svg viewBox="0 0 820 260" role="img" aria-label="Tone 7 Hz và tone 3 Hz đi qua cùng một tập sample khi sampling ở 10 Hz">
          <line class="sample-axis" x1={aliasPlot.left} y1={aliasPlot.mid} x2={aliasPlot.width - aliasPlot.right} y2={aliasPlot.mid} />
          <polyline class="alias-fast-wave" points={aliasFastPoints} />
          <polyline class="alias-slow-wave" points={aliasSlowPoints} />
          <g class="alias-sample-dots">
            {aliasSamples.map((sample) => (
              <circle cx={sample.x} cy={sample.y} r="5" />
            ))}
          </g>
        </svg>
        <div class="alias-story-legend">
          <span><i class="legend-fast"></i> waveform nhanh <MathExpr tex={String.raw`7\,\mathrm{Hz}`} /></span>
          <span><i class="legend-slow"></i> waveform chậm <MathExpr tex={String.raw`3\,\mathrm{Hz}`} /></span>
          <span><i class="legend-dot"></i> samples ở <MathExpr tex={String.raw`10\,\mathrm{Hz}`} /></span>
        </div>
      </div>

      <p>
        Với một cosine <MathExpr tex={String.raw`7\,\mathrm{Hz}`} /> được lấy mẫu ở <MathExpr tex={String.raw`10\,\mathrm{Hz}`} />:
      </p>

      <MathExpr tex={String.raw`7\,\mathrm{Hz} \;\longrightarrow\; |7-10| = 3\,\mathrm{Hz}`} display />
      <p class="math-caption"><MathExpr tex={String.raw`7\,\mathrm{Hz}`} /> nằm phía trên <MathExpr tex={String.raw`f_s/2 = 5\,\mathrm{Hz}`} /> và bị “fold” về <MathExpr tex={String.raw`3\,\mathrm{Hz}`} />.</p>

      <p>
        Sau sampling, các giá trị <MathExpr tex="x[n]" /> của tone <MathExpr tex={String.raw`7\,\mathrm{Hz}`} /> trùng với một tone <MathExpr tex={String.raw`3\,\mathrm{Hz}`} /> tại đúng các sample time.
        Receiver chỉ nhìn dãy sample thì không thể biết chắc waveform analog trước ADC là <MathExpr tex={String.raw`7\,\mathrm{Hz}`} /> hay <MathExpr tex={String.raw`3\,\mathrm{Hz}`} />.
        Hiện tượng một thành phần tần số cao xuất hiện như một tần số thấp khác được gọi là <strong>aliasing</strong>.
      </p>
    </section>

    <section class="concept-block lab-section" id="aliasing-lab">
      <p class="concept-kicker">03 · INTERACTIVE LAB</p>
      <h2>Đi qua ba trạng thái Safe → Nyquist boundary → Aliasing, rồi nhìn cùng hiện tượng ở time domain và frequency domain.</h2>
      <p>
        Demo dùng một cosine đơn để giữ hình dễ đọc.
        <strong>Time view</strong> cho thấy waveform và sample points.
        <strong>Spectrum view</strong> cho thấy copies xuất hiện cách nhau <MathExpr tex="f_s" /> và frequency nào rơi vào principal Nyquist interval.
      </p>
      <SamplingAliasExplorer client:load />
    </section>

    <section class="concept-block" id="nyquist">
      <p class="concept-kicker">04 · NYQUIST</p>
      <h2>Với một signal band-limited, sampling phải đủ nhanh để các bản sao spectrum không chồng lên nhau.</h2>
      <p>
        Giả sử signal không có thành phần tần số nào cao hơn B Hz.
        Trong mô hình lý tưởng, định lý Nyquist-Shannon cho ta điều kiện thường viết là:
      </p>

      <MathExpr tex="f_s > 2B" display />
      <p class="math-caption">Sampling rate phải lớn hơn hai lần tần số cao nhất cần giữ lại trong ideal band-limited model.</p>

      <p>
        Một cách nhìn ở miền tần số là: sampling tạo ra các bản sao của spectrum cách nhau <MathExpr tex="f_s" />.
        Nếu <MathExpr tex="f_s" /> đủ lớn, các bản sao đứng tách nhau. Nếu <MathExpr tex="f_s" /> quá nhỏ, chúng chồng lên nhau và phần bị chồng chính là aliasing.
      </p>

      <div class="nyquist-spectrum-grid nyquist-spectrum-grid-v2">
        <article>
          <span class="sampling-stage-label"><MathExpr tex="f_s>2B" /> · CÁC SUPPORT TÁCH NHAU</span>
          <svg viewBox="0 0 480 180" role="img" aria-label="Spectrum support từ -B tới B và các copies quanh cộng trừ fs không chồng lên nhau">
            <line class="sample-axis" x1="20" y1="132" x2="460" y2="132" />
            <path class="spectrum-copy muted-copy" d="M38 132 L76 82 L114 132 Z" />
            <path class="spectrum-copy main-copy" d="M202 132 L240 58 L278 132 Z" />
            <path class="spectrum-copy muted-copy" d="M366 132 L404 82 L442 132 Z" />
            <foreignObject x="50" y="136" width="58" height="26"><div xmlns="http://www.w3.org/1999/xhtml" class="svg-math"><MathExpr tex="-f_s" /></div></foreignObject>
            <foreignObject x="186" y="136" width="42" height="26"><div xmlns="http://www.w3.org/1999/xhtml" class="svg-math"><MathExpr tex="-B" /></div></foreignObject>
            <foreignObject x="230" y="136" width="26" height="26"><div xmlns="http://www.w3.org/1999/xhtml" class="svg-math"><MathExpr tex="0" /></div></foreignObject>
            <foreignObject x="270" y="136" width="42" height="26"><div xmlns="http://www.w3.org/1999/xhtml" class="svg-math"><MathExpr tex="+B" /></div></foreignObject>
            <foreignObject x="388" y="136" width="58" height="26"><div xmlns="http://www.w3.org/1999/xhtml" class="svg-math"><MathExpr tex="+f_s" /></div></foreignObject>
          </svg>
          <p>Baseband support nằm trong <MathExpr tex={String.raw`[-B,B]`} />. Copy gần nhất bắt đầu tại khoảng <MathExpr tex={String.raw`f_s-B`} />.</p>
        </article>
        <article>
          <span class="sampling-stage-label"><MathExpr tex="f_s<2B" /> · SUPPORT CHỒNG LÊN NHAU</span>
          <svg viewBox="0 0 480 180" role="img" aria-label="Các spectral copies chồng lên baseband support khi sampling rate quá thấp">
            <line class="sample-axis" x1="20" y1="132" x2="460" y2="132" />
            <path class="spectrum-copy muted-copy" d="M82 132 L168 68 L254 132 Z" />
            <path class="spectrum-copy main-copy" d="M154 132 L240 52 L326 132 Z" />
            <path class="spectrum-copy muted-copy" d="M226 132 L312 68 L398 132 Z" />
            <rect class="spectrum-overlap" x="154" y="83" width="100" height="49" rx="4" />
            <rect class="spectrum-overlap" x="226" y="83" width="100" height="49" rx="4" />
            <text class="sample-svg-label" x="201" y="109">overlap</text>
            <text class="sample-svg-label" x="282" y="109">overlap</text>
          </svg>
          <p>Khi copy kế bên chạm vào support chính, spectral information bị trộn và không thể tách lại chỉ từ samples.</p>
        </article>
      </div>

      <MathExpr tex={String.raw`f_s-B>B\quad\Longrightarrow\quad f_s>2B`} display />
      <p class="math-caption">Khoảng cách từ tâm copy kế bên tới mép support chính dẫn trực tiếp tới điều kiện Nyquist trong low-pass model này.</p>

      <aside class="mental-model">
        <strong>Một cách nhìn khác</strong>
        <p>
          Nyquist không nói rằng “hai sample là đủ để vẽ đẹp một chu kỳ”.
          Nó nói về khả năng biểu diễn và khôi phục một signal band-limited trong mô hình lý tưởng.
          Trong hệ thống thực, filter không lý tưởng nên thường cần khoảng guard và sampling rate cao hơn mức biên lý thuyết.
        </p>
      </aside>
    </section>

    <section class="concept-block" id="nyquist-rate-frequency">
      <p class="concept-kicker">05 · HAI CỤM TỪ DỄ NHẦM</p>
      <h2>Nyquist rate và Nyquist frequency không phải cùng một đại lượng.</h2>

      <div class="math-card-grid">
        <article class="math-card">
          <span class="card-label">NYQUIST RATE</span>
          <div class="math-card-formula"><MathExpr tex="2B" /></div>
          <p>
            Nếu signal cần giữ tới <MathExpr tex={String.raw`B\,\mathrm{Hz}`} />, <MathExpr tex="2B" /> là tốc độ lấy mẫu tối thiểu theo mô hình lý tưởng thường được nhắc tới.
          </p>
        </article>
        <article class="math-card">
          <span class="card-label">NYQUIST FREQUENCY</span>
          <div class="math-card-formula"><MathExpr tex="f_s/2" /></div>
          <p>
            Với sampling rate <MathExpr tex="f_s" />, discrete-time frequency lặp theo chu kỳ <MathExpr tex="f_s" />.
            Với signal real low-pass, ta thường chọn principal interval từ <MathExpr tex="0" /> tới <MathExpr tex="f_s/2" /> cho positive frequencies; thành phần cao hơn có thể fold về một frequency tương đương trong interval này.
          </p>
        </article>
      </div>

      <p>
        Ví dụ một ADC đang chạy ở <MathExpr tex={String.raw`20\,\mathrm{MHz}`} /> có Nyquist frequency là <MathExpr tex={String.raw`10\,\mathrm{MHz}`} />.
        Còn nếu signal cần giữ có bandwidth từ DC tới <MathExpr tex={String.raw`4\,\mathrm{MHz}`} />, Nyquist rate lý tưởng của signal đó là <MathExpr tex={String.raw`8\,\mathrm{MHz}`} />.
        Hai câu đang nhìn cùng bài toán từ hai phía khác nhau.
      </p>
    </section>

    <section class="concept-block" id="anti-alias">
      <p class="concept-kicker">06 · NGOÀI ĐỜI THỰC</p>
      <h2>ADC không thể trông chờ mọi thứ phía trên <MathExpr tex="f_s/2" /> tự biến mất.</h2>
      <p>
        Signal analog thực tế có thể chứa noise, blocker hoặc các thành phần ngoài bandwidth ta quan tâm.
        Nếu chúng đi thẳng vào ADC, những thành phần phía trên Nyquist frequency có thể alias vào dải cần giữ.
      </p>

      <div class="anti-alias-flow">
        <div>
          <small>ANALOG INPUT</small>
          <strong>signal + out-of-band energy</strong>
        </div>
        <b>→</b>
        <div class="filter-stage">
          <small>TRƯỚC ADC</small>
          <strong>Anti-alias filter</strong>
        </div>
        <b>→</b>
        <div>
          <small>ADC</small>
          <strong>sampling @ <MathExpr tex="f_s" /></strong>
        </div>
        <b>→</b>
        <div>
          <small>DIGITAL</small>
          <strong><MathExpr tex="x[n]" /></strong>
        </div>
      </div>

      <p>
        Anti-alias filter là filter analog đặt trước sampling để làm suy giảm các thành phần không muốn giữ.
        Vì transition band của filter thực không thể dựng đứng tại một tần số duy nhất, hệ thống thường chọn <MathExpr tex="f_s" />
        cao hơn giới hạn lý thuyết để có khoảng chuyển tiếp dễ thiết kế hơn. Đây là một lý do oversampling rất hữu ích.
      </p>

      <aside class="precision-note">
        <strong>Aliasing xảy ra trước khi DSP có cơ hội sửa nó</strong>
        <p>
          Một khi hai thành phần analog khác nhau đã tạo ra cùng dãy samples, một filter digital thông thường không thể
          tự biết thành phần nào là “đúng”. Vì vậy chống alias phải bắt đầu từ trước ADC hoặc từ kiến trúc sampling phù hợp.
        </p>
      </aside>
    </section>

    <section class="concept-block" id="wireless">
      <p class="concept-kicker">07 · NỐI LẠI VỚI WIRELESS</p>
      <h2>Sampling rate quyết định cách receiver số nhìn thấy bandwidth mà RF front-end đưa vào.</h2>
      <p>
        Trong một receiver wireless, RF front-end và downconversion đưa phần spectrum cần quan tâm về một dạng phù hợp cho ADC.
        ADC sau đó tạo time-domain samples để các khối như synchronization, FFT, channel estimation và demodulation xử lý.
      </p>

      <div class="sampling-receiver-flow" data-lesson-visual>
        <div><small>ANALOG / RF FRONT-END</small><strong>band of interest</strong><span>continuous-time signal sau frequency selection/downconversion phù hợp</span></div>
        <b>→</b>
        <div class="filter-stage"><small>ANTI-ALIAS FILTER</small><strong>limit analog bandwidth</strong><span>giảm out-of-band energy trước sampling</span></div>
        <b>→</b>
        <div><small>ADC</small><strong>sample @ <MathExpr tex="f_s" /></strong><span>continuous-time → discrete-time</span></div>
        <b>→</b>
        <div><small>DIGITAL PROCESSING</small><strong><MathExpr tex="x[n]" /></strong><span>samples đi vào các thuật toán DSP ở những bài sau</span></div>
      </div>

      <p>
        Trong bài này, Nyquist được minh họa bằng signal real, low-pass để giữ trực giác đơn giản.
        Khi học complex baseband ở Bài 5, positive/negative frequency và bandwidth sẽ được diễn giải bằng một model phù hợp hơn.
        Bài 2 chỉ cần giữ một nguyên tắc: <strong>ADC phải nhận một analog bandwidth phù hợp với sampling rate của nó.</strong>
      </p>
    </section>

    <section class="concept-block recap">
      <p class="concept-kicker">08 · NỐI LẠI CÁC Ý</p>
      <h2>Tới đây ta có thể nhìn sampling như một bài toán giữ đủ thông tin, không chỉ là “đo thật nhiều điểm”.</h2>
      <ol class="recap-list">
        <li><strong>Sampling</strong> làm rời rạc thời gian: <MathExpr tex="x[n]=x(nT_s)" />.</li>
        <li><strong>Sampling rate</strong> là <MathExpr tex="f_s=1/T_s" />.</li>
        <li><strong>Aliasing</strong> xảy ra khi những thành phần khác nhau trở nên không phân biệt được sau sampling.</li>
        <li><strong>Nyquist-Shannon</strong> cho signal band-limited một điều kiện lý tưởng để tránh spectral overlap: <MathExpr tex="f_s" /> &gt; 2B; đúng tại biên <MathExpr tex="f_s/2" /> là một edge case nhạy với phase.</li>
        <li><strong>Nyquist frequency</strong> là <MathExpr tex="f_s/2" />, còn <strong>Nyquist rate</strong> của signal band-limited tới B là 2B.</li>
        <li><strong>Anti-alias filter</strong> phải xử lý out-of-band energy trước ADC.</li>
      </ol>
    </section>

