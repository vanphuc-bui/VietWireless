---
import 'katex/dist/katex.min.css';
import '../styles/global.css';

const {
  title = 'VietWireless | Ghi chép trực quan về viễn thông',
  description = 'Những ghi chép trực quan về signal, wireless, 4G, 5G NR, NTN và 6G, kèm đồ thị và interactive labs.',
} = Astro.props;
---

<!doctype html>
<html lang="vi">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#fbfaf7" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href="/" aria-label="VietWireless home">
        <span class="brand-mark" aria-hidden="true">≈</span>
        <span>
          <strong>VietWireless</strong>
          <small>Ghi chép về viễn thông</small>
        </span>
      </a>
      <nav class="site-nav" aria-label="Điều hướng chính">
        <a href="/#lich-su">Lịch sử</a>
        <a href="/#buc-tranh-lon">Bức tranh lớn</a>
        <a href="/hoc/">Lộ trình học</a>
        <a href="/#tai-sao">Về VietWireless</a>
      </nav>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div>
        <strong>VietWireless</strong>
        <p>Một góc nhìn trực quan về tín hiệu, wireless, 4G, 5G, NTN và 6G.</p>
      </div>
      <div class="footer-note">
        <p>Viết bởi <a href="https://vanphucbui.com/" target="_blank" rel="noreferrer">Van-Phuc Bui</a>.</p>
        <p>Nội dung kỹ thuật độc lập, dựa trên kiến thức và nguồn công khai.</p>
      </div>
    </footer>
  </body>
</html>
