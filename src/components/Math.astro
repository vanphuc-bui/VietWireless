---
import katex from 'katex';
import { assertValidTex } from '../utils/validateTex.js';

interface Props {
  tex: string;
  display?: boolean;
  class?: string;
}

const {
  tex,
  display = false,
  class: className = '',
} = Astro.props;

assertValidTex(tex, 'Math.astro');

const html = katex.renderToString(tex, {
  displayMode: display,
  throwOnError: true,
  strict: 'warn',
  trust: false,
  output: 'htmlAndMathml',
});
---

{display ? (
  <div class:list={['math-display', className]} set:html={html}></div>
) : (
  <span class:list={['math-inline', className]} set:html={html}></span>
)}
